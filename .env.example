# ---------------------------------------------------------------------------
# PDF Genie - environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. Everything without a NEXT_PUBLIC_ prefix stays server-side only.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Safe to expose to the browser. Row Level Security is what protects your data,
# not the secrecy of this key. (Older projects call this the "anon" key - the
# legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# NEVER expose this. It bypasses every RLS policy and is used only inside
# server route handlers, after a share token or session has been validated.
# (Legacy name SUPABASE_SERVICE_ROLE_KEY is also accepted.)
SUPABASE_SECRET_KEY="sb_secret_..."

# Private Storage bucket holding the uploaded PDFs.
SUPABASE_STORAGE_BUCKET="documents"

# --- Cohere (embeddings + reranking) ---------------------------------------
# https://dashboard.cohere.com/api-keys
# A trial key allows only ~1,000 calls/month and 10 rerank req/min; use a
# production key if you plan to iterate much.
COHERE_API_KEY=""
COHERE_EMBED_MODEL="embed-v4.0"
COHERE_RERANK_MODEL="rerank-v4.0-fast"

# --- Amazon Bedrock (chat + summaries) -------------------------------------
# Bedrock is region-scoped and model access must be requested per region in the
# console; it is not enabled by default.
BEDROCK_AWS_REGION="us-east-1"

# Preferred: a long-lived Bedrock API key (Bedrock console > API keys).
BEDROCK_API_KEY=""

# Alternative to BEDROCK_API_KEY: a plain IAM key pair. These are deliberately
# BEDROCK_-prefixed because Vercel functions run on Lambda, where the bare
# AWS_ACCESS_KEY_ID / AWS_REGION names are reserved by the runtime itself.
BEDROCK_AWS_ACCESS_KEY_ID=""
BEDROCK_AWS_SECRET_ACCESS_KEY=""

# The `us.` inference-profile prefix works for every Nova model in us-east-1
# and avoids "on-demand throughput isn't supported" errors.
BEDROCK_CHAT_MODEL_ID="us.amazon.nova-2-lite-v1:0"

# Small, cheap model used only to rewrite follow-up questions into standalone
# search queries before retrieval.
BEDROCK_UTILITY_MODEL_ID="us.amazon.nova-micro-v1:0"

# --- App -------------------------------------------------------------------
# Absolute origin, used to build share links and auth redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
